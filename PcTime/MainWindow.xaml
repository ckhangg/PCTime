<Window x:Class="PcTime.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Time" Width="1260" Height="820" MinWidth="1120" MinHeight="720" Background="#0B0D12" Foreground="#E8EAF0" FontFamily="./Fonts/#Be Vietnam Pro" FontSize="13" UseLayoutRounding="True">
<Window.Resources>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="./Fonts/#Chakra Petch"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#A3ABBD"/><Setter Property="Margin" Value="0,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Frame" Padding="16,14" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="#291422"/><Setter TargetName="Frame" Property="BorderBrush" Value="#FF1F8F"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#211B29"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#67E8F9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="#0D0F15" BorderBrush="#1E2330" BorderThickness="0,0,1,0" Padding="18,28,18,20"><DockPanel LastChildFill="True">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,32"><StackPanel Orientation="Horizontal"><Border Background="#291422" CornerRadius="9" Padding="8,4" Margin="0,0,9,0"><TextBlock Text="◷" FontSize="24" Foreground="#FF1F8F"/></Border><TextBlock Text="PC TIME" FontFamily="./Fonts/#Chakra Petch" FontWeight="Bold" FontSize="24" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Thời gian của bạn" Foreground="#8B93A7" FontSize="11" Margin="0,10,0,0"/></StackPanel>
  <Border DockPanel.Dock="Bottom" Background="#12151D" BorderBrush="#262B38" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="Trạng thái theo dõi" Foreground="#8B93A7" FontSize="11"/><TextBlock x:Name="StatusLabel" Text="Đang khởi động…" Foreground="#67E8F9" TextWrapping="Wrap" Margin="0,10,0,14" FontSize="12"/><Button x:Name="PauseButton" Content="Tạm dừng" Click="Pause_Click"/><TextBlock Text="Đóng cửa sổ để thu&#10;xuống khay hệ thống" Foreground="#8B93A7" FontSize="10" Margin="0,12,0,0"/></StackPanel></Border>
  <StackPanel><RadioButton x:Name="OverviewNav" Content="◈   Tổng quan" Tag="Overview" GroupName="Nav" Checked="Nav_Changed" IsChecked="True"/><RadioButton Content="▦   Ứng dụng" Tag="Applications" GroupName="Nav" Checked="Nav_Changed"/><RadioButton Content="◷   Lịch sử" Tag="History" GroupName="Nav" Checked="Nav_Changed"/><RadioButton Content="⚙   Cài đặt" Tag="Settings" GroupName="Nav" Checked="Nav_Changed"/></StackPanel>
 </DockPanel></Border>
 <Grid Grid.Column="1" Margin="30,28,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Tổng quan" Style="{StaticResource Heading}"/><TextBlock x:Name="PageSubtitle" Text="Nhìn lại thời gian sử dụng máy của bạn." Foreground="#A3ABBD" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" x:Name="ExportButton" Content="Xuất CSV" Click="Export_Click" VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1" x:Name="ReportPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions><TextBlock Text="Ngày báo cáo" Foreground="#A3ABBD" VerticalAlignment="Center"/><DatePicker Grid.Column="1" x:Name="ReportDate" SelectedDateChanged="Date_Changed" Height="32" Foreground="#E8EAF0" Background="#12151D" BorderBrush="#262B38"><DatePicker.Resources><Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="#E8EAF0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePickerTextBox"><Border Background="#12151D" Padding="5"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style></DatePicker.Resources></DatePicker></Grid>
   <Grid Grid.Row="1" x:Name="SummaryPanel" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Background="#12151D" BorderBrush="#262B38" BorderThickness="1" CornerRadius="14" Padding="22"><StackPanel><TextBlock Text="Tổng thời gian sử dụng" Foreground="#A3ABBD"/><TextBlock x:Name="TotalLabel" Text="00:00:00" FontFamily="Consolas" FontSize="48" Foreground="#67E8F9" Margin="0,10,0,4"/><TextBlock Text="Giờ : phút : giây" Foreground="#8B93A7" FontSize="11"/></StackPanel></Border><Border Grid.Column="1" Background="#18121C" BorderBrush="#493047" BorderThickness="1" CornerRadius="14" Padding="20" Margin="14,0,0,0"><StackPanel><TextBlock Text="Dùng nhiều nhất" Foreground="#A3ABBD"/><TextBlock x:Name="TopAppLabel" Text="Chưa có dữ liệu" FontFamily="./Fonts/#Chakra Petch" FontSize="22" Foreground="#FF1F8F" Margin="0,14,0,8" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AppCountLabel" Foreground="#8B93A7" FontSize="12"/></StackPanel></Border></Grid>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel>
<UniformGrid Columns="4" Margin="0,0,0,16">
<Border Background="#121D24" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Work" Foreground="#67E8F9"/><TextBlock x:Name="WorkTotal" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="#231423" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Game" Foreground="#FF65AD"/><TextBlock x:Name="GameTotal" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="#211D17" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Giải trí" Foreground="#FFC369"/><TextBlock x:Name="EntertainmentTotal" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
<Border Background="#171B25" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="Khác" Foreground="#ADBBD3"/><TextBlock x:Name="OtherTotal" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border>
</UniformGrid><TextBlock Text="Ứng dụng và game" FontFamily="./Fonts/#Chakra Petch" FontWeight="SemiBold" FontSize="20" Margin="0,0,0,12"/></StackPanel><Border Grid.Row="1" Background="#12151D" BorderBrush="#262B38" BorderThickness="1" CornerRadius="12" Padding="4"><Grid><DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="66" Background="Transparent" BorderThickness="0" AlternationCount="2" HorizontalScrollBarVisibility="Disabled"><DataGrid.Columns><DataGridTemplateColumn Header="Ứng dụng" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Process}" Foreground="#8B93A7" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Nhóm" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="Đổi nhóm cho ứng dụng này, áp dụng cho mọi ngày"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Thời gian" Binding="{Binding Duration}" Width="190"/><DataGridTemplateColumn Header="Tỷ lệ" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Share}" Foreground="#67E8F9" FontFamily="Consolas" FontSize="12"/><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,7,0,0" Foreground="#FF1F8F" Background="#262B38" BorderThickness="0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="Chưa có dữ liệu cho ngày này." Foreground="#8B93A7" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=AppsGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></Grid>
  </Grid>
  <Grid Grid.Row="1" x:Name="HistoryPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="14 ngày gần nhất · Nhấp đúp một ngày để xem ứng dụng" Foreground="#A3ABBD" Margin="0,0,0,18"/><DataGrid Grid.Row="1" x:Name="HistoryGrid" MouseDoubleClick="History_Open" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="#12151D" BorderBrush="#262B38" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="44" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="Ngày" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Tổng thời gian" Binding="{Binding Duration}" Width="230"/><DataGridTextColumn Header="Số ứng dụng" Binding="{Binding Count}" Width="140"/></DataGrid.Columns></DataGrid></Grid>
  <StackPanel Grid.Row="1" x:Name="SettingsPanel" Visibility="Collapsed"><Border Background="#12151D" BorderBrush="#262B38" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="Theo dõi thời gian" FontFamily="./Fonts/#Chakra Petch" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Ngừng tính sau một khoảng không thao tác chuột hoặc bàn phím." Foreground="#A3ABBD" Margin="0,10,0,16" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><TextBlock Text="Nhận biết nghỉ sau" VerticalAlignment="Center"/><ComboBox x:Name="IdleMinutes" SelectedIndex="1" Width="120" Margin="20,0,0,0" SelectionChanged="Idle_Changed"><ComboBoxItem Content="1 phút" Tag="1"/><ComboBoxItem Content="5 phút" Tag="5"/><ComboBoxItem Content="10 phút" Tag="10"/><ComboBoxItem Content="15 phút" Tag="15"/></ComboBox></StackPanel><CheckBox x:Name="KeepCounting" Content="Vẫn tính khi xem phim hoặc chơi bằng tay cầm" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,22,0,0"/><TextBlock Text="Khi bật, app chỉ ngừng tính nếu máy khóa, sleep hoặc bạn tạm dừng." Foreground="#8B93A7" Margin="28,8,0,0" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border><Border Background="#12151D" BorderBrush="#262B38" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="Khởi động và dữ liệu" FontFamily="./Fonts/#Chakra Petch" FontSize="20" FontWeight="SemiBold"/><CheckBox x:Name="StartupCheck" Content="Chạy dưới khay hệ thống khi đăng nhập Windows" Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,20,0,0"/><TextBlock Text="Lịch sử và cài đặt lưu cục bộ trên máy, không cần tài khoản." Foreground="#8B93A7" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
  <TextBlock Grid.Row="2" x:Name="SaveLabel" Text="Dữ liệu lưu trên máy" FontSize="11" Foreground="#8B93A7" Margin="0,16,0,0" TextWrapping="Wrap"/>
 </Grid>
</Grid>
</Window>

